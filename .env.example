# Paper-Workbench configuration. Everything defaults to offline fake mode.

# fake (default, zero network) | live (requires keys below)
WB_PROVIDER_MODE=fake

WB_DATABASE_URL=sqlite:///data/workbench.sqlite3
WB_DATA_DIR=data

# LLM (used only in live mode)
WB_LLM_PROVIDER=openai          # openai | anthropic
WB_LLM_MODEL=gpt-5.2
WB_ANTHROPIC_MODEL=claude-sonnet-5
# WB_OPENAI_API_KEY=
# WB_ANTHROPIC_API_KEY=

# Discovery (used only in live mode)
# WB_BRAVE_SEARCH_API_KEY=
WB_BRAVE_RATE_LIMIT_SECONDS=1.1

# Auth (off by default — local single-user needs no credentials).
# When true, WB_AUTH_SECRET MUST be set to a strong (>=32 char) value.
WB_AUTH_REQUIRED=false
# WB_AUTH_SECRET=change-me-to-a-long-random-string
WB_AUTH_TTL_MINUTES=720
# OIDC (only when provider_mode=live and issuer set)
# WB_OIDC_ISSUER=
# WB_OIDC_AUDIENCE=
# WB_OIDC_JWKS_URL=

# Export: auto (WeasyPrint if GTK present else fallback) | weasyprint | minimal
WB_PDF_RENDERER=auto
# Optional local entry-point file from an official JATS 1.3 DTD distribution.
# Empty uses the bundled, honestly labeled structural subset. No DTD is downloaded at runtime.
# WB_JATS_DTD_PATH=C:\path\to\JATS-journalpublishing1-3.dtd
