# Paper-Workbench configuration. Defaults are local and offline.

# Load .env/.env.local files found from the current directory upward.
WB_LOAD_DOTENV=true

# Runtime and persistence
WB_DATABASE_URL=sqlite:///data/workbench.sqlite3
# WB_MIGRATION_DATABASE_URL=
WB_DB_POOL_MODE=default
WB_DATA_DIR=data
WB_DEPLOYMENT_MODE=local
WB_RUN_MIGRATIONS_ON_STARTUP=true
WB_ARTIFACT_STORAGE_BACKEND=local
WB_ARTIFACT_MAX_READ_BYTES=100000000
WB_UPLOAD_MAX_BYTES=4000000
# Hosted vercel_blob storage obtains its credential from the provider environment.
# BLOB_READ_WRITE_TOKEN=

# Providers: fake is the default and makes no model or search network calls.
WB_PROVIDER_MODE=fake
# openai | anthropic | codex_local
WB_LLM_PROVIDER=openai
WB_LLM_MODEL=gpt-5.2
WB_ANTHROPIC_MODEL=claude-sonnet-5
WB_LLM_MAX_OUTPUT_TOKENS=4096
# WB_OPENAI_API_KEY=
# WB_ANTHROPIC_API_KEY=
# WB_BRAVE_SEARCH_API_KEY=
WB_BRAVE_RATE_LIMIT_SECONDS=1.1

# Delegated research is disabled until an operator supplies an explicit process command.
WB_RESEARCH_EXECUTOR_ENABLED=false
WB_RESEARCH_EXECUTOR_COMMAND=[]
# WB_RESEARCH_CODEX_HOME=C:/Users/<you>/.paper-workbench-codex
# WB_RESEARCH_CODEX_ACCOUNT_EMAIL=
WB_RESEARCH_CODEX_MODEL=gpt-5.6-sol
WB_RESEARCH_CODEX_REASONING_EFFORT=low

# Optional pinned local semantic-retrieval model. Setup is an explicit separate step.
WB_RESEARCH_SEMANTIC_MODEL=minilm
# WB_RESEARCH_SEMANTIC_MODEL_DIR=C:/absolute/path/to/pinned-model

# Local ChatGPT/Codex manuscript chat is independently opt-in. It is supported only
# through the dedicated loopback launcher documented in docs/CODEX-LOCAL.md.
WB_CODEX_LOCAL_ENABLED=false
# WB_CODEX_LOCAL_GATE_SECRET=
# WB_CODEX_LOCAL_HOME=C:/Users/<you>/.paper-workbench-codex
# WB_CODEX_LOCAL_ACCOUNT_EMAIL=
# WB_CODEX_LOCAL_WORKSPACE_ID=
WB_CODEX_LOCAL_MODEL=gpt-5.6-sol
WB_CODEX_LOCAL_REASONING_EFFORT=xhigh
WB_CODEX_LOCAL_TIMEOUT_SECONDS=120
WB_CODEX_LOCAL_MAX_INPUT_TOKENS=200000
WB_CODEX_LOCAL_MAX_OUTPUT_TOKENS=1000000

# Auth is off for local single-user operation. Enforced auth requires a strong secret.
WB_AUTH_REQUIRED=false
# WB_AUTH_SECRET=
WB_AUTH_TTL_MINUTES=720
WB_AUTH_ALLOW_REGISTRATION=false
WB_AUTH_PASSWORD_LOGIN_ENABLED=true
# WB_AUTH_BOOTSTRAP_TOKEN=
WB_AUTH_TOKEN_ISSUER=paper-workbench
WB_AUTH_TOKEN_AUDIENCE=paper-workbench-api
WB_AUTH_CLOCK_SKEW_SECONDS=30
WB_AUTH_COOKIE_SESSIONS_ENABLED=false
WB_AUTH_COOKIE_SECURE=true
WB_AUTH_COOKIE_NAME=wb_session
WB_AUTH_CSRF_COOKIE_NAME=wb_csrf

# OIDC is independent of WB_PROVIDER_MODE. Production auth uses live. Fake OIDC is
# limited to offline tests/local work and is refused when WB_AUTH_REQUIRED=true.
WB_OIDC_MODE=disabled
# WB_OIDC_ISSUER=
# WB_OIDC_AUDIENCE=
# WB_OIDC_JWKS_URL=
WB_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
WB_OIDC_JWKS_TIMEOUT_SECONDS=5
WB_OIDC_REQUIRE_HTTPS=true
# WB_OIDC_TENANT_CLAIM=
WB_OIDC_ALLOW_EMAIL_LINKING=false
WB_OIDC_ALLOW_JIT_PROVISIONING=false
WB_OIDC_ALLOW_JIT_MEMBERSHIP=false
WB_OIDC_BROWSER_ENABLED=false
# WB_OIDC_CLIENT_ID=
# WB_OIDC_CLIENT_SECRET=
# WB_OIDC_AUTHORIZATION_URL=
# WB_OIDC_TOKEN_URL=
# WB_OIDC_REDIRECT_URI=
WB_OIDC_SCOPE=openid profile email
WB_OIDC_FLOW_COOKIE_NAME=wb_oidc_flow
WB_OIDC_FLOW_TTL_MINUTES=10

# Export: auto | weasyprint | minimal
WB_PDF_RENDERER=auto
# WB_JATS_DTD_PATH=C:/absolute/path/to/JATS-journalpublishing1-3.dtd

# Local reproducible compute. Each run still needs hash-bound approval and confirmation.
WB_COMPUTE_ENABLED=true
WB_COMPUTE_MAX_TIMEOUT_SECONDS=300
WB_COMPUTE_MAX_OUTPUT_FILES=100
WB_COMPUTE_MAX_OUTPUT_BYTES=50000000
WB_COMPUTE_MAX_LOG_BYTES=1000000
WB_COMPUTE_CONTAINER_RUNTIME=docker
# WB_COMPUTE_CONTAINER_DEFAULT_IMAGE=repository@sha256:<64-lowercase-hex-characters>
WB_COMPUTE_CONTAINER_MAX_MEMORY_MB=4096
WB_COMPUTE_CONTAINER_MAX_CPUS=4.0
WB_COMPUTE_CONTAINER_MAX_PIDS=256
